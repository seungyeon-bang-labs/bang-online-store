# 로컬 개발은 .env.development.local에 적습니다. npm run dev는 이 파일을 .env.local보다 먼저 읽습니다.
# 개발 서버는 로컬 Supabase(localhost/127.0.0.1)에만 연결하고, 다른 주소면 오류로 멈춥니다.
# 로컬 값: SUPABASE_URL=http://127.0.0.1:54321, SUPABASE_ANON_KEY는 `npx supabase status`의 anon key
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 32바이트 base64 값 (예: openssl rand -base64 32)
PASSWORD_RECOVERY_SECRET=

# 정확히 true일 때만 회원가입·이메일 인증·비밀번호 찾기를 허용합니다.
# 로컬 개발: true / 배포 데모 및 기본값: false
AUTH_FEATURES_ENABLED=false
