# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# local agent/tool state
/.superpowers/

# local project documentation
/docs/db/
/docs/**/*.md

# credentials
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
